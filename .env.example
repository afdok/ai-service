# IA coupée pour ce déploiement : AI_ENABLED=false
AI_ENABLED=true

# Fournisseur (relais quand l'application n'a pas de configuration enregistrée active)
# google (défaut) | azure_openai | mistral | openai_compatible
AI_PROVIDER=google
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
# AZURE_API_KEY=
# AZURE_RESOURCE_NAME=
# AZURE_BASE_URL=
# MISTRAL_API_KEY=
# AI_BASE_URL=
# AI_API_KEY=

# Chiffrement des clés API enregistrées : 32 octets en base64 ou hexadécimal
AI_ENCRYPTION_KEY=

# Signature des approbations d'écriture du chat : 32 caractères au moins
TOOL_APPROVAL_SECRET=

# Requêtes IA par minute et par utilisateur
AI_RATE_LIMIT_PER_MINUTE=20
